# CloudOps AI — environment configuration template
# Copy to .env.cloudops and replace placeholders with private values.
# Never commit real credentials.

# Administrator authentication
CLOUDOPS_ADMIN_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN
CLOUDOPS_SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET

# Browser security
# Set true only after configuring and validating HTTPS.
CLOUDOPS_HTTPS_ENABLED=false

# AI troubleshooting
# Enable after configuring a reachable AI provider.
CLOUDOPS_AI_ENABLED=false
CLOUDOPS_AI_PROVIDER=ollama
CLOUDOPS_AI_MODEL=qwen3:4b

# Local Ollama example; change for the actual deployment environment.
CLOUDOPS_OLLAMA_URL=http://host.docker.internal:11434

# OpenAI-compatible provider (optional)
# CLOUDOPS_AI_API_KEY=REPLACE_WITH_API_KEY
# CLOUDOPS_AI_ENDPOINT=REPLACE_WITH_PROVIDER_ENDPOINT

# Redis-backed request limiting and AI inference budgeting
CLOUDOPS_RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
CLOUDOPS_AI_BUDGET_REDIS_URL=redis://redis:6379/0

# Internal Prometheus endpoint
PROMETHEUS_URL=http://prometheus:9090

# Disable intentional error simulation by default
ENABLE_ERROR_SIMULATION=false
